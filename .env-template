# Shared configuration modules require the Nextflow v1 syntax parser.
NXF_VER=24.10.6
NXF_SYNTAX_PARSER=v1

# External NFTest fixtures: two mzML fractions of one sample or plex, a
# matching target-decoy FASTA, and an MSFragger JAR for its dedicated case.
SEARCH_MZML_F1=/path/to/fraction-1.mzML
SEARCH_MZML_F2=/path/to/fraction-2.mzML
SEARCH_FASTA=/path/to/target-decoy.fasta
MSFRAGGER_JAR=/path/to/MSFragger.jar
NFT_TEMP=/path/to/nftest/temp
