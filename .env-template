NXF_VER=24.10.6
NXF_SYNTAX_PARSER=v1
TEST_DATA_DIR=/data/user/czhu/data/pipeline_test_data

# Optional cluster: boutroslab_aws or pines. Unset uses the default Docker profile.
NFT_CLUSTER=boutroslab_aws

# Base directory for test runs. AWS adds $SLURM_JOB_ID; Pines uses this directly.
# If unset, defaults to the repository root.
NFT_RUN_ROOT=/scratch
