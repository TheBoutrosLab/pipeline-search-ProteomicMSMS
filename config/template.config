includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

params {
    input_csv = "/path/to/input.csv"
    output_dir = '/path/to/output/dir'
    save_intermediate_files = false
    ucla_cds = false

    decoy_database = '/path/to/decoy_database.fasta'
    search_engines = ['Comet', 'Sage', 'MSFragger']
    sample_name = 'sample-01'

    msfragger_executable = '/path/to/MSFragger.jar'    // Supply the separately licensed JAR.
    export_mzTab = true
    export_all_psms = true
    merge_proteins_add_PSMs = true
    fix_msfragger_spectrum_refs = false
    comet_default_params = "${projectDir}/input/NO_FILE" // Optional native Comet parameter file.

    reindex_mzml = true
    reindex_mzml_keep_all_metadata = true

    SageAdapter {
        decoy_prefix = 'DECOY_'
        precursor_tol_left = -10.0
        precursor_tol_right = 10.0
        precursor_tol_unit = 'ppm'
        fragment_tol_left = -20.0
        fragment_tol_right = 20.0
        fragment_tol_unit = 'ppm'
        missed_cleavages = 2
        fixed_modifications = ['Carbamidomethyl (C)']
        variable_modifications = ['Oxidation (M)']
        q_value_threshold = 1.0 // Keep unfiltered PSMs for downstream validation.
        PeptideIndexing {
            decoy_string = 'DECOY_'
            decoy_string_position = 'prefix'
            unmatched_action = 'remove'
        }
    }

    CometAdapter {
        num_hits = 1
        instrument = 'high_res'

        // spectrum
        minimum_peaks = 15

        // precursor ions
        isotope_error = '0/1/2'
        precursor_charge = '1:5'
        max_precursor_charge = 5
        precursor_error_units = 'ppm'
        precursor_mass_tolerance = 30.0

        // fragment ions
        max_fragment_charge = 3
        fragment_bin_offset = 0.0
        fragment_mass_tolerance = 0.01 // half of fragment_bin_tol
        fragment_error_units = 'Da'

        // enzyme
        enzyme = 'Trypsin'
        missed_cleavages = 2
        num_enzyme_termini = 'fully'
        min_peptide_length = 7
        max_peptide_length = 35

        // modifications
        fixed_modifications = [
            'Carbamidomethyl (C)'
        ]
        variable_modifications = [
            'Oxidation (M)',
            'Acetyl (Protein N-term)',
            'Gln->pyro-Glu (N-term Q)',
        ]
        max_variable_mods_in_peptide = 3
        clip_nterm_methionine = true

        PeptideIndexing {

            decoy_string = 'DECOY_'
            decoy_string_position = 'prefix'
            unmatched_action = 'remove'

        }
    }

    MSFraggerAdapter {
        license = 'yes'

        spectrum {
            minimum_peaks = 15
            max_fragment_charge = '3'
            use_topn_peaks = 150 // default 150 in MSFragger but 50 in OpenMS
        }

        tolerance {
            isotope_error = '0/1/2'

            precursor_mass_tolerance_lower = 30.0
            precursor_mass_tolerance_upper = 30.0
            precursor_mass_unit = 'ppm'

            fragment_mass_tolerance = 0.02
            fragment_mass_unit = 'Da'
        }

        digest {
            search_enzyme_name = 'Trypsin'
            allowed_missed_cleavage = '2'
            num_enzyme_termini = 'fully'
            min_length = 7
            max_length = 35
        }

        statmod {
            add_C_cysteine = 57.021464 // Carbamidomethyl
        }

        varmod {
            clip_nterm_m = true
            max_variable_mods_per_peptide = '3'
            not_allow_multiple_variable_mods_on_residue = true

            masses = [
                42.010565,        // Acetyl:13C(2) (Protein N-term)
                -17.026549,       // Gln-&gt;pyro-Glu (N-term Q)
            ]
            syntaxes = [
                '[^',             // Acetyl:13C(2) (Protein N-term)
                'nQ',             // Gln-&gt;pyro-Glu (N-term Q)
            ]

            unimod = [
                'Oxidation (M)'
            ]
        }

        search {
            output_report_topn = 1
        }

        PeptideIndexing {
            decoy_string = 'DECOY_'
            decoy_string_position = 'prefix'
            unmatched_action = 'remove'
        }
    }
}

methods.setup()
