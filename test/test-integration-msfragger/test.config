includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

def requiredEnvironment = { String name ->
    def value = System.getenv(name)
    if (!value) throw new IllegalArgumentException("${name} must be set for this NFTest case")
    return value
}

params {
    input_csv = "${projectDir}/test/test-integration-msfragger/input.csv"
    output_dir = ''
    sample_name = 'SBP0001'
    decoy_database = requiredEnvironment('SEARCH_FASTA')
    search_engines = ['MSFragger']
    reindex_mzml = true
    save_intermediate_files = true
    export_mzTab = true
    msfragger_executable = requiredEnvironment('MSFRAGGER_JAR')
    MSFraggerAdapter { license = 'yes' }
}

params.input_csv = csvEnvironmentExpander.prepareInputCsv(params.input_csv, 'test-integration-msfragger', launchDir)
methods.setup()
